PORT=5000
MONGODB_URI=
# CORS + refresh-cookie topology:
# - CLIENT_ORIGIN must be the exact frontend origin (credentials mode forbids "*").
# - The refresh cookie is sameSite=lax: frontend and API must share a registrable
#   domain in production (e.g. app.example.com + api.example.com).
# - With NODE_ENV=production the cookie is Secure: HTTPS is required end to end.
CLIENT_ORIGIN=http://localhost:3000
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
SEED_ADMIN_EMAIL=admin@wos.local
SEED_ADMIN_PASSWORD=

# Gemini AI (optional — AI endpoints return 503 until set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
