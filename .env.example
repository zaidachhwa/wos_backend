PORT=5000
MONGODB_URI=
# CORS + refresh-cookie topology:
# - CLIENT_ORIGIN must be the exact frontend origin (credentials mode forbids "*").
#   Also used as the Socket.IO CORS origin (utils/io.js) — get this wrong and
#   the websocket connection is refused too, not just HTTP requests.
# - The refresh cookie is sameSite=lax by default: frontend and API must share
#   a registrable domain (e.g. app.example.com + api.example.com — same-site
#   even across subdomains, Lax works fine there).
# - If the frontend and API are on genuinely different registrable domains
#   (e.g. app.example.com + api.otherdomain.com), set COOKIE_CROSS_SITE=true
#   below — switches the cookie to sameSite=none + Secure, the only way a
#   cross-site request carries it at all. Requires HTTPS end to end.
# - With NODE_ENV=production (or COOKIE_CROSS_SITE=true) the cookie is
#   Secure: HTTPS is required end to end.
CLIENT_ORIGIN=http://localhost:3000
COOKIE_CROSS_SITE=false
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Google OAuth client ID used to verify /auth/google ID tokens (Sign in with
# Google). Must match the audience the frontend requests tokens for.
GOOGLE_CLIENT_ID=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
SEED_ADMIN_EMAIL=admin@wos.local
SEED_ADMIN_PASSWORD=

# Gemini AI (optional — AI endpoints return 503 until set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Resend (optional — the only mail service in the app; the 8:30pm evening
# follow-up reminder sweep silently sends 0 emails until this is set)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
